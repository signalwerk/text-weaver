{
  "name": "text-weaver",
  "version": "1.4.0",
  "description": "Rejoins wrapped lines and fixes hyphen-splits with a LLM (or without it).",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cli": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "bin": {
    "textweaver": "./src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalwerk/text-weaver.git"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "sh test.sh"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "engines": {
    "node": ">=18"
  }
}
